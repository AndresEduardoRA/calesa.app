# Supabase (local: npx supabase start te imprime estos valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Sólo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Push web (VAPID). Generar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@ejemplo.com

# Integración apibara (scraper de Copart/IAAI). Vacío = desactivada.
APIBARA_API_KEY=

# Web pública (otro repo): URL y secreto para revalidar su caché cuando cambia el contenido
WEB_PUBLICA_REVALIDAR_URL=
WEB_PUBLICA_REVALIDAR_SECRETO=

# Google OAuth (lo lee supabase/config.toml en local; en la nube va en Auth › Providers)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
