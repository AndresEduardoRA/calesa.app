# Supabase (local: npx supabase start te imprime estos valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Sólo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Push web (VAPID). Generar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@ejemplo.com

# Correo de la app: ninguno | mailpit | resend | cloudflare. Cada proveedor pide sus variables (docs/ENTORNOS.md › Correo);
# `pnpm email:probar <destino>` manda un correo de prueba. Sólo servidor.
EMAIL_PROVEEDOR=ninguno
EMAIL_REMITENTE=
EMAIL_REMITENTE_NOMBRE=
# mailpit: el correo local (http://127.0.0.1:54624)
MAILPIT_URL=
# resend
RESEND_API_KEY=
# cloudflare: el ID de cuenta (32 hexadecimales) y un token con Email Sending: Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# La clave de apibara no va acá: se carga en Configuración › Empresa › Integraciones (Vault).

# La revalidación de la web pública tampoco: dirección y secreto en Configuración › Empresa › Integraciones › Web pública.

# Google OAuth (lo lee supabase/config.toml en local; en la nube va en Auth › Providers)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
