{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx supabase *)",
      "Bash(bash scripts/*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npx supabase db push*)",
      "Bash(rm -rf /*)",
      "Bash(npm i -g *)",
      "Bash(npm install -g *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git branch -D*)",
      "Bash(gh workflow run*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(supabase link*)",
      "Bash(npx supabase link*)",
      "Bash(supabase secrets*)",
      "Bash(npx supabase secrets*)",
      "Bash(pnpm add*)",
      "Bash(pnpm up*)",
      "Bash(npx next upgrade*)",
      "Bash(pnpm next upgrade*)",
      "Bash(pnpm exec next upgrade*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bloquear-peligrosos.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-archivo.sh",
            "timeout": 30,
            "statusMessage": "Linting el archivo…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verificar-al-terminar.sh",
            "timeout": 240,
            "statusMessage": "Verificando antes de terminar (mapa, typecheck, lint, tests)…"
          }
        ]
      }
    ]
  }
}
